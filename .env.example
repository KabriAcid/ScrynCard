# Browser-safe frontend configuration. Never prefix private values with VITE_.
VITE_API_URL=http://localhost:3000/api/v1
VITE_APP_NAME=Scryncard
VITE_APP_ENV=development

# Backend configuration (the backend is not yet implemented in this repository).
NODE_ENV=development
API_PORT=3000
APP_URL=http://localhost:8080
DATABASE_URL=postgresql://postgres:password@localhost:5432/scryn

# Server-side JWT secrets. Generate unique values for each environment.
# Example: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=replace_with_a_random_secret
REFRESH_TOKEN_SECRET=replace_with_a_different_random_secret

# SME Plug API. Keep the private key on the server; never expose it to Vite.
SME_PLUG_BASE_URL=https://smeplug.ng/api/v1
SME_PLUG_KEY=replace_with_your_private_key
SME_PLUG_TIMEOUT_MS=30000

# SMTP settings for server-side email delivery.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_EMAIL=your_sender_email@example.com
SMTP_PASSWORD=replace_with_an_app_password
SMTP_FROM_NAME="Scryn Ltd."
